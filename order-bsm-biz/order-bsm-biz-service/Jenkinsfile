pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo '========== Checkout monkey-ams =========='

                git(
                    branch: 'main',
                    url: 'https://github.com/kekegao/monkey-ams.git'
                )
            }
        }

        stage('Check Workspace') {
            steps {
                    sh '''
                        echo "JOB_NAME=$JOB_NAME"
                        echo "WORKSPACE=$WORKSPACE"

                        echo "========== Jenkins Workspace =========="

                        ls -lah /var/jenkins_home/workspace/${JOB_NAME}

                        echo "========== order-bsm-biz =========="

                        ls -lah /var/jenkins_home/workspace/${JOB_NAME}

                        echo "========== POM =========="

                        ls -lh /var/jenkins_home/workspace/${JOB_NAME}/pom.xml
                    '''
                }
        }




        stage('Build order-bsm-biz') {
            steps {
                echo '========== 构建 order-bsm-biz =========='

                sh '''
                    docker run --rm \
                        -v jenkins_jenkins_home:/var/jenkins_home \
                        -v jenkins-maven-repo:/root/.m2 \
                        -w /var/jenkins_home/workspace/${JOB_NAME}/order-bsm-biz\
                        maven:3.9.11-eclipse-temurin-21 \
                        mvn install -DskipTests
                '''
            }
        }



        stage('Check JAR') {
            steps {
            echo '========== 检查 Spring Boot JAR =========='

            sh '''
                echo "========== WORKSPACE =========="
                pwd
                echo "$WORKSPACE"

                echo "========== 当前目录 =========="
                ls -lah

                echo "========== 查找所有 JAR =========="

                find "$WORKSPACE" \
                    -type f \
                    -name "*.jar" \
                    -ls
            '''
            }
        }

        stage('Docker Build') {
            steps {
                echo '========== Docker Build =========='

                sh '''
                    cd "$WORKSPACE/order-bsm-biz/order-bsm-biz-service"

                    echo "========== JAR =========="

                    ls -lh target/*.jar

                    mkdir -p docker-context

                    cp Dockerfile docker-context/
                    cp target/order-bsm-biz-service-*.jar docker-context/app.jar

                    cd docker-context

                    docker build \
                        -t monkey-order-bsm-service:latest \
                        .
                '''
            }
        }

        stage('Check Docker Image') {
            steps {
                echo '========== 检查 Docker Image =========='

                sh '''
                    docker images | grep monkey-order-bsm-service
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo '========== 部署 order-bsm-biz-service =========='

                sh '''
                    echo "========== 停止旧容器 =========="

                    docker stop order-bsm-biz-service || true

                    echo "========== 删除旧容器 =========="

                    docker rm order-bsm-biz-service || true

                    echo "========== 启动新容器 =========="

                    docker run -d \
                        --name order-bsm-biz-service \
                        --network ai-network \
                        -p 8088:8080 \
                        --restart unless-stopped \
                        monkey-order-bsm-service:latest

                    echo "========== 容器状态 =========="

                    docker ps \
                        --filter "name=order-bsm-biz-service"

                    echo "========== 最近日志 =========="

                    docker logs \
                        --tail 100 \
                        order-bsm-biz-service
                '''
            }
        }
    }

    post {
        success {
            echo '========== 部署成功 =========='
        }

        failure {
            echo '========== 部署失败 =========='
        }
    }
}