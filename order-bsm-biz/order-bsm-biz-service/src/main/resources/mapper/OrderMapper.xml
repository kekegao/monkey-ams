<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monkey.order.bsm.biz.mapper.OrderMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.monkey.order.bsm.biz.entity.Order">
        <id column="id" property="id" />
        <result column="order_id" property="orderId" />
        <result column="status" property="status" />
        <result column="shipper_user_id" property="shipperUserId" />
        <result column="shipper_name" property="shipperName" />
        <result column="shipper_mobile" property="shipperMobile" />
        <result column="carrier_user_id" property="carrierUserId" />
        <result column="carrier_name" property="carrierName" />
        <result column="carrier_mobile" property="carrierMobile" />
        <result column="goods_type" property="goodsType" />
        <result column="goods_description" property="goodsDescription" />
        <result column="goods_weight" property="goodsWeight" />
        <result column="shipper_province" property="shipperProvince" />
        <result column="shipper_city" property="shipperCity" />
        <result column="shipper_area" property="shipperArea" />
        <result column="shipper_address" property="shipperAddress" />
        <result column="carrier_province" property="carrierProvince" />
        <result column="carrier_city" property="carrierCity" />
        <result column="carrier_area" property="carrierArea" />
        <result column="carrier_address" property="carrierAddress" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, order_id, status, shipper_user_id, shipper_name, shipper_mobile, carrier_user_id, carrier_name, carrier_mobile, delete_flag, create_time, update_time
    </sql>

    <select id="selectListByCondition" resultType="com.monkey.order.bsm.biz.dto.OrderDto">
        select <include refid="Base_Column_List"/> from tf_b_order
    </select>

    <!-- 已发布订单列表查询列（含状态描述、运费等列表页所需字段） -->
    <sql id="Publish_Column_List">
        id, order_id, status, status_desc, shipper_user_id, shipper_user_name, shipper_name, shipper_mobile,
        carrier_user_id, carrier_user_name, carrier_name, carrier_mobile, goods_type, goods_description,
        goods_weight, transport_money, shipper_province, shipper_city, shipper_area, shipper_address,
        carrier_province, carrier_city, carrier_area, carrier_address, delete_flag, create_time, update_time
    </sql>

    <!-- 货主已发布订单列表：按货主查询，支持按状态筛选，按发布时间倒序 -->
    <select id="selectPublishOrderList" resultType="com.monkey.order.bsm.biz.dto.OrderDto">
        select <include refid="Publish_Column_List"/>
        from tf_b_order
        where delete_flag = 0
          and shipper_user_id = #{shipperUserId}
        <if test="status != null">
          and status = #{status}
        </if>
        order by create_time desc, id desc
    </select>

</mapper>
