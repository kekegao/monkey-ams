<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.monkey.account.bsm.biz.mapper.FrozenDetailMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.monkey.account.bsm.biz.entity.FrozenDetail">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="user_name" property="userName" />
        <result column="frozen_no" property="frozenNo" />
        <result column="biz_type" property="bizType" />
        <result column="biz_type_name" property="bizTypeName" />
        <result column="order_no" property="orderNo" />
        <result column="amount" property="amount" />
        <result column="frozen_time" property="frozenTime" />
        <result column="status" property="status" />
        <result column="status_desc" property="statusDesc" />
        <result column="finish_time" property="finishTime" />
        <result column="remark" property="remark" />
        <result column="delete_flag" property="deleteFlag" />
        <result column="create_time" property="createTime" />
        <result column="create_name" property="createName" />
        <result column="update_time" property="updateTime" />
        <result column="update_name" property="updateName" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, user_id, user_name, frozen_no, biz_type, biz_type_name, order_no, amount, frozen_time, status, status_desc, finish_time, remark, delete_flag, create_time, create_name, update_time, update_name
    </sql>

    <!-- 查询当前用户「冻结中」的冻结明细：status=1 且未删除，按冻结时间倒序 -->
    <select id="selectFrozenDetailList" resultType="com.monkey.account.bsm.biz.dto.FrozenDetailDto">
        select <include refid="Base_Column_List"/>
        from tf_b_frozen_detail
        where user_id = #{userId}
          and delete_flag = 0
        order by frozen_time desc, id desc
    </select>

</mapper>
